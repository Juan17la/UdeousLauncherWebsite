  "narrative": {
    "northStar": "The Lineup Sheet",
    "overview": "The page is a festival bill set in one typeface. Rank is carried by size and line breaks alone: the download is the headliner, the headline features are support acts, and the small names run together in one justified block. The colours are the launcher's own, kept as-is: a pale blue day theme and a night-blue dark theme, one blue accent, no neon. Structure is flat and ruled, with one drenched open-source band. Pixelify Sans appears only in the wordmark.",
    "keyCharacteristics": [
      "One face, Geist, at weight 800 with tight negative tracking; hierarchy by size only.",
      "Three giant OS download cells; the visitor's own system fills with the accent.",
      "Hairline-ruled sections on a bg tinted by two faint accent glows.",
      "One drenched accent band, one accent colour everywhere else.",
      "Geist Mono for versions, sizes and file kinds."
    ],
    "rules": [
      {
        "name": "The One Blue Rule",
        "body": "Blue is the only chromatic colour on the page. The own-system cell and the open-source band are the two places it floods; elsewhere it marks selection and action only.",
        "section": "colors"
      },
      {
        "name": "The Launcher's Own Rule",
        "body": "Tokens mirror the launcher app, light and dark pairs both. Do not add hues, neon or glow to freshen them.",
        "section": "colors"
      },
      {
        "name": "The Size-Only Rule",
        "body": "Rank is expressed by font size and line break. Weight stays 800 for all ranked type; never colour, italics or decoration to create emphasis.",
        "section": "typography"
      },
      {
        "name": "The Wordmark-Only Rule",
        "body": "Pixelify Sans is never used for headings or body.",
        "section": "typography"
      },
      {
        "name": "The Hairline Edge Rule",
        "body": "Surfaces separate by a 1px ring and a tonal step, never by a heavy shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do rank content by size and line break in Geist 800 with -0.04em to -0.05em tracking.",
      "Do fill only the visitor's own OS cell with #2563EB / #336CEB and keep the others outlined by tone.",
      "Do separate sections with 1px hairlines and keep panels flat with an edge ring.",
      "Do keep light and dark token pairs in sync with the launcher.",
      "Do give every interactive element the 2px blue focus-visible outline."
    ],
    "donts": [
      "Don't introduce neon, extra hues or glowing gradients.",
      "Don't use Pixelify Sans outside the wordmark.",
      "Don't build equal feature-card grids or a split hero with a product shot; the bill is the layout.",
      "Don't add a second drenched surface; the open-source band is the only one besides the own-system cell."
    ]
  }
